{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "esModuleInterop": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../.expo/types/**/*.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts",
    "features/**/*.ts"
  ]
}
